{
  "name": "bymoffice",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Open, edit and save Word and Excel files (docx, xlsx, doc, xls, RTF) in the browser: one script, no server, no dependencies",
  "homepage": "https://busrayesilyurtmehmetoglu.github.io/bymoffice/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/busrayesilyurtmehmetoglu/bymoffice.git"
  },
  "bugs": {
    "url": "https://github.com/busrayesilyurtmehmetoglu/bymoffice/issues"
  },
  "type": "module",
  "keywords": [
    "docx",
    "xlsx",
    "doc",
    "xls",
    "rtf",
    "word",
    "excel",
    "spreadsheet",
    "document",
    "editor",
    "viewer",
    "docx-editor",
    "xlsx-editor",
    "spreadsheet-editor",
    "document-editor",
    "word-processor",
    "office",
    "office-documents",
    "canvas",
    "webview",
    "collaborative-editing",
    "pdf",
    "typescript",
    "zero-dependency"
  ],
  "main": "dist/bymoffice.esm.js",
  "module": "dist/bymoffice.esm.js",
  "types": "dist/types/index.d.ts",
  "unpkg": "dist/bymoffice.min.js",
  "jsdelivr": "dist/bymoffice.min.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/bymoffice.esm.js",
      "default": "./dist/bymoffice.esm.js"
    },
    "./webview.html": "./dist/bymoffice.webview.html",
    "./fonts/*": "./dist/fonts/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "server",
    "README.tr.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.json && node scripts/fix-types.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-timeout=180000 test/*.test.ts",
    "corpus": "tsx scripts/corpus.ts",
    "corpus:baseline": "tsx scripts/corpus.ts --local",
    "verify": "pnpm typecheck && pnpm test && pnpm e2e && pnpm pack:check && pnpm corpus:baseline && BYM_NO_NATIVE=1 pnpm corpus:baseline",
    "demo": "pnpm build && E2E_PORT=4318 node e2e/server.mjs",
    "e2e": "pnpm build && node scripts/build-site.mjs && playwright test",
    "site": "pnpm build && node scripts/build-site.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.25.0",
    "ssf": "0.11.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
